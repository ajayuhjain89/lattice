# Lattice reference ingress (Phase 11, P11.1; docs/deployment.md §4). LOCAL ONLY.
#
# It plays the production ingress's role in the local reference stack: TLS termination,
# /api/* straight to the API pool, everything else to the web server, and the only
# trusted forwarding hop (the API trusts X-Forwarded-* from this container's fixed
# address alone, LATTICE_TRUSTED_PROXIES). Its certificate comes from Caddy's internal
# CA and is trusted by nothing: it is not a stand-in for the public staging certificate.
#
# Forwarding: with no `trusted_proxies` here, Caddy discards any X-Forwarded-For /
# X-Forwarded-Proto a client sends and sets them from the connection it accepted, so a
# client cannot choose the address the API sees.
{
	admin localhost:2019
	# The ports the host publishes, so redirects and URLs carry the right port.
	http_port 8080
	https_port 8443
	servers {
		timeouts {
			# Time to receive a request; responses are bounded per upstream below. The
			# export upload route sets its own, longer body deadline (request_body below).
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

# The API pool (both instances), with the time an instance may take to start answering
# once the whole request is written ({args[0]}).
(api_pool) {
	reverse_proxy api1:8000 api2:8000 {
		lb_policy round_robin
		lb_try_duration 5s
		health_uri /v1/health/ready
		health_interval 5s
		health_timeout 3s
		health_status 200
		fail_duration 10s
		transport http {
			dial_timeout 5s
			response_header_timeout {args[0]}
		}
	}
}

https://localhost:8443, https://caddy:8443 {
	tls internal

	# The one route that accepts a large body (P12.6): an export uploaded to a source,
	# POST /api/v1/admin/sources/<uuid>/imports. Its body is streamed to the API (never
	# buffered here) and the API's own limits are authoritative (LATTICE_IMPORT_MAX_UPLOAD_BYTES,
	# 100 MiB by default, 413 request_too_large; LATTICE_IMPORT_UPLOAD_TIMEOUT_SECONDS, 600 s).
	# The edge stops a body just above that size and one still arriving after 600 s.
	# Raising the API's limits means raising these with them (docs/deployment.md §4).
	@import_upload {
		method POST
		path_regexp ^/api/v1/admin/sources/[0-9a-fA-F-]{36}/imports$
	}
	request_body @import_upload {
		max_size 101MiB
		read_timeout 600s
	}
	# All other requests: the API's own 64 KiB cap (LATTICE_MAX_REQUEST_BYTES, 413
	# request_too_large) is the authoritative limit; this only stops oversized bodies at
	# the edge. No other route needs more than 64 KiB.
	@ordinary_body {
		not {
			method POST
			path_regexp ^/api/v1/admin/sources/[0-9a-fA-F-]{36}/imports$
		}
	}
	request_body @ordinary_body {
		max_size 1MB
	}

	# /api/* → the API pool, prefix stripped (/api/v1/ask → /v1/ask). Two instances,
	# round robin, a request moved to the other instance if one refuses the connection,
	# and only instances whose readiness passes receive traffic.
	handle_path /api/* {
		# A migrating release (stop-the-world, D-23; deployment.md §9.2): while
		# /srv/maintenance/api exists (deploy/deploy.sh), /api/* answers 503 + Retry-After
		# in the API's error envelope instead of reaching a stopped or migrating API.
		@maintenance file {
			root /srv/maintenance
			try_files /api
		}
		handle @maintenance {
			header Retry-After 30
			header Cache-Control no-store
			header Content-Type application/json
			header Content-Security-Policy "default-src 'none'"
			respond `{"error":{"code":"service_unavailable","message":"Lattice is being updated. Try again shortly.","request_id":""}}` 503
		}
		# An upload is answered once it has been received AND validated (the archive is
		# checked entry by entry before the response): up to the API's 600 s upload budget.
		@import_upload_api {
			method POST
			path_regexp ^/v1/admin/sources/[0-9a-fA-F-]{36}/imports$
		}
		handle @import_upload_api {
			import api_pool 600s
		}
		handle {
			# An Ask may spend LATTICE_GENERATION_DEADLINE_SECONDS (120 s) generating plus
			# retrieval: the contract asks for at least 150 s.
			import api_pool 180s
		}
	}

	# The ingress's own failures on /api/* (P11.7 drills): no instance passes readiness
	# (the database is down, 503), the chosen instance died mid-request or refused for
	# longer than lb_try_duration (502), or no response header within 180 s (504). The
	# client gets what the API itself answers when it is unavailable -- 503
	# service_unavailable, Retry-After: 5, the API's CSP -- never Caddy's empty error.
	handle_errors 502 503 504 {
		@api expression `{http.request.orig_uri.path}.startsWith("/api/")`
		handle @api {
			header Retry-After 5
			header Cache-Control no-store
			header Content-Type application/json
			header Content-Security-Policy "default-src 'none'"
			respond `{"error":{"code":"service_unavailable","message":"Lattice is temporarily unavailable.","request_id":""}}` 503
		}
	}

	# Every other path → the web servers (no /api route exists there in production), two
	# instances like the API so a release can replace one at a time.
	handle {
		reverse_proxy web1:3000 web2:3000 {
			lb_policy round_robin
			lb_try_duration 5s
			health_uri /
			health_interval 5s
			health_timeout 3s
			fail_duration 10s
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}

# Plain HTTP only redirects (explicit, so the redirect keeps the published port).
http://localhost:8080, http://caddy:8080 {
	redir https://{host}:8443{uri} 308
}
