# Lattice local configuration.
#
#   cp .env.example .env
#
# Every value below is a LOCAL-DEVELOPMENT placeholder. None of them is a real secret,
# and none may be reused outside a developer machine. Never commit `.env`.
# The API validates its settings at startup and exits naming any missing or invalid
# LATTICE_* variable (values are never echoed).

# --- Local Postgres container (compose.yaml) --------------------------------------
# Superuser password for the container. Used only by the bootstrap and by the test
# that proves a BYPASSRLS role is refused.
POSTGRES_PASSWORD=local-superuser-password
# Login passwords for the two login roles created by infra/postgres/bootstrap.sql.
LATTICE_OWNER_PASSWORD=local-owner-password
LATTICE_APP_PASSWORD=local-app-password
# Host port the container is published on (bound to 127.0.0.1 only).
LATTICE_DB_HOST_PORT=5433

# --- Application --------------------------------------------------------------------
# Required. One of: development | test | production. There is no default.
LATTICE_ENV=development

# Required. Runtime connection used by the API. MUST use the lattice_app role:
# the API refuses to start if this role is a superuser, has BYPASSRLS, is a member of
# such a role, or can act as the owner of Lattice tables.
LATTICE_DATABASE_URL=postgresql+asyncpg://lattice_app:local-app-password@127.0.0.1:5433/lattice

# Required for `make migrate` and `make seed` only (operator tools, not the API).
# Uses the lattice_owner role, which owns the schema.
LATTICE_MIGRATION_DATABASE_URL=postgresql+asyncpg://lattice_owner:local-owner-password@127.0.0.1:5433/lattice

# Development-only persona login (POST /v1/auth/dev-login). Allowed only when
# LATTICE_ENV is development or test; setting it to true in production is a
# startup error. Default: false.
LATTICE_DEV_AUTH_ENABLED=true

# Session cookie `Secure` flag. Default: true. May be false only in development/test
# (plain-HTTP localhost); production refuses false.
LATTICE_SESSION_COOKIE_SECURE=false

# Optional (defaults shown).
# LATTICE_SESSION_IDLE_TIMEOUT_MINUTES=720
# LATTICE_SESSION_ABSOLUTE_TIMEOUT_MINUTES=10080
# LATTICE_LOG_LEVEL=INFO

# --- Model providers (ingestion) ----------------------------------------------------
# Optional. Needed only for `lattice sync --embedding openai` / `make sync
# EMBEDDING=openai` (ADR-008). `make sync` uses the deterministic fake provider by
# default, which needs no key and makes no network call. Never commit a real key.
# LATTICE_OPENAI_API_KEY=
# LATTICE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Tests (make test) ---------------------------------------------------------------
# Tests run against the separate lattice_test database, never against `lattice`.
LATTICE_TEST_DATABASE_URL=postgresql+asyncpg://lattice_app:local-app-password@127.0.0.1:5433/lattice_test
LATTICE_TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://lattice_owner:local-owner-password@127.0.0.1:5433/lattice_test
LATTICE_TEST_SUPERUSER_DATABASE_URL=postgresql+asyncpg://postgres:local-superuser-password@127.0.0.1:5433/lattice_test
# Optional: examples for the SQL <-> reference authorization proof (default and CI
# minimum 500). Raise it for a deeper local run, e.g. 5000.
# LATTICE_AUTHZ_EXAMPLES=500
