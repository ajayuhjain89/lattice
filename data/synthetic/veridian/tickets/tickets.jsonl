{"id": "HAL-4533", "subject": "Refund request - duplicate annual subscription", "organization_id": 5100203, "status": "closed", "priority": "normal", "type": "question", "via": "email", "group": "Billing", "created_at": "2026-06-02T10:00:00Z", "updated_at": "2026-06-05T09:00:00Z", "tags": ["refund"], "requester": {"name": "Omar Farah", "email": "omar.farah@quarrylane.example"}, "assignee": {"name": "Felix Wagner", "email": "felix.wagner@veridian.example"}, "comments": [{"id": 453301, "author": {"name": "Omar Farah", "email": "omar.farah@quarrylane.example"}, "author_role": "end-user", "public": true, "created_at": "2026-06-02T10:00:00Z", "body": "We were billed twice for our annual subscription (two workspaces by mistake). Can we get a refund for one?"}, {"id": 453302, "author": {"name": "Felix Wagner", "email": "felix.wagner@veridian.example"}, "author_role": "agent", "public": true, "created_at": "2026-06-02T11:10:00Z", "body": "Hi Omar — our refund policy allows a full refund within 30 days of the start of the term, and the second subscription started on 20 May, so you're covered. I've asked Finance to refund it."}, {"id": 453303, "author": {"name": "Felix Wagner", "email": "felix.wagner@veridian.example"}, "author_role": "agent", "public": true, "created_at": "2026-06-05T09:00:00Z", "body": "Finance confirmed the refund was issued today."}]}
