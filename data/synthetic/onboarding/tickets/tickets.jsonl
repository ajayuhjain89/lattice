{"id": "WRN-1001", "subject": "Quillon telemetry gaps on Ashgrove depot gateways", "organization_id": 7100001, "status": "solved", "priority": "high", "type": "incident", "via": "email", "group": "Tier 2", "created_at": "2026-09-14T08:10:00Z", "updated_at": "2026-09-15T16:40:00Z", "tags": ["telemetry", "firmware"], "requester": {"name": "Imogen Hart", "email": "imogen.hart@ashgrove.example"}, "assignee": {"name": "Riley Moss", "email": "riley.moss@wrenfield.example"}, "comments": [{"id": 100101, "author": {"name": "Imogen Hart", "email": "imogen.hart@ashgrove.example"}, "author_role": "end-user", "public": true, "created_at": "2026-09-14T08:10:00Z", "body": "Since the firmware 4.3.0 update our Quillon telemetry has gaps of up to an hour on three depot gateways."}, {"id": 100102, "author": {"name": "Riley Moss", "email": "riley.moss@wrenfield.example"}, "author_role": "agent", "public": true, "created_at": "2026-09-15T16:40:00Z", "body": "Rolling the depot gateways back to firmware 4.2.7 restored the Quillon telemetry feed. We will hold 4.3.x until the vendor patch arrives."}]}
{"id": "WRN-1002", "subject": "Ashgrove invoice address change", "organization_id": 7100001, "status": "closed", "priority": "low", "type": "question", "via": "email", "group": "Tier 1", "created_at": "2026-09-18T10:00:00Z", "updated_at": "2026-09-18T11:00:00Z", "tags": ["billing"], "requester": {"name": "Imogen Hart", "email": "imogen.hart@ashgrove.example"}, "assignee": {"name": "Sam Okoro", "email": "sam.okoro@wrenfield.example"}, "comments": [{"id": 100201, "author": {"name": "Imogen Hart", "email": "imogen.hart@ashgrove.example"}, "author_role": "end-user", "public": true, "created_at": "2026-09-18T10:00:00Z", "body": "Please send invoices to the new accounts payable address from October."}]}
{"id": "WRN-1003", "subject": "Brindle Foods freezer alert thresholds", "organization_id": 7100002, "status": "open", "priority": "normal", "type": "task", "via": "web", "group": "Tier 1", "created_at": "2026-09-22T13:00:00Z", "updated_at": "2026-09-22T13:30:00Z", "tags": ["alerts"], "requester": {"name": "Owen Pike", "email": "owen.pike@brindle.example"}, "assignee": {"name": "Sam Okoro", "email": "sam.okoro@wrenfield.example"}, "comments": [{"id": 100301, "author": {"name": "Owen Pike", "email": "owen.pike@brindle.example"}, "author_role": "end-user", "public": true, "created_at": "2026-09-22T13:00:00Z", "body": "Please lower the freezer alert threshold to minus 19 degrees on every Harwick site."}]}
