{
  "name": "@lattice/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 3000 --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screens": "playwright test --project=screens --workers=2",
    "screens:canonical": "CANONICAL_DIR=../../docs/screens playwright test --project=screens --workers=2",
    "api:schema": "cd ../../backend && uv run --extra local python scripts/export_openapi.py ../apps/web/src/api/openapi.json",
    "api:types": "openapi-typescript src/api/openapi.json -o src/api/schema.gen.ts --default-non-nullable false && prettier --write src/api/schema.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
